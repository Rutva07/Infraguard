# Copy this file to .env and replace values when you are ready to use AWS.
# Never commit .env or AWS secret keys.
AWS_REGION=us-east-1
AWS_PROFILE=REPLACE_WITH_AWS_CLI_PROFILE
INFRAGUARD_S3_BUCKET=REPLACE_WITH_UNIQUE_BUCKET_NAME
INFRAGUARD_S3_PREFIX=telemetry
INFRAGUARD_ATHENA_DATABASE=infraguard
INFRAGUARD_ATHENA_TABLE=telemetry
INFRAGUARD_ATHENA_WORKGROUP=primary
INFRAGUARD_ATHENA_RESULTS_S3=s3://REPLACE_WITH_UNIQUE_BUCKET_NAME/athena-results/
